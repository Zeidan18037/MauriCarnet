# Supabase - Clés du projet
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Supabase - Clé service_role (PRIVEE - jamais côté client)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# API - Token pour sécuriser le endpoint /api/sync (DÉPRÉCIÉ — utiliser JWT Supabase Auth)
API_SYNC_TOKEN=generer-une-chaine-aleatoire-securisee

# Vercel - Token API pour Vercel MCP (PRIVEE)
# À récupérer depuis https://vercel.com/account/tokens
VERCEL_API_TOKEN=votre-token-vercel
